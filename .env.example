# ─────────────────────────────────────────────────────────
# Ninelm Web (Next.js) — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────

# ── Waitlist emails (server-side only) ───────────────────
# Get from: resend.com → API Keys
# Free tier: 3,000 emails/month
# If not set, waitlist signups are accepted but no notification is sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Public app environment (baked into bundle at build time) ──
# Options: development, staging, production
# Development and staging link to staging LRR; production links to production LRR.
NEXT_PUBLIC_APP_ENV=development
